-- 4.2. СТРАНЫ С САМЫМ ВЫСОКИМ ЧИСЛОМ СМЕРТЕЙ НА ДУШУ НАСЕЛЕНИЯ
-- в предыдущие запросы не входят некоторые локации, поэтому мы исключим их для сохранения единообразия.

SELECT location, SUM(new_deaths::NUMERIC) as total_death_count
FROM "CovidDeaths"
WHERE continent IS NULL
      AND location NOT IN ('World', 'European Union', 'International')
GROUP BY location
ORDER BY total_death_count DESC;



-- 4.3. СТРАНЫ С САМЫМ ВЫСОКИМ УРОВНЕМ ЗАРАЖЕНИЯ
-- Используем подзапрос для поиска максимального числа заражений и соответствующего процентного показателя.

SELECT * FROM (
    SELECT location, population, 
           MAX(total_cases) as highest_infection_count, 
           MAX((total_cases::NUMERIC / population)*100) as percent_population_infected
    FROM "CovidDeaths"
    GROUP BY location, population
) t
ORDER BY percent_population_infected DESC;



-- 4.4. СТРАНЫ С САМЫМ ВЫСОКИМ УРОВНЕМ ЗАРАЖЕНИЯ (TIME-SERIES)
-- То же самое, но с сохранением столбца «date» для построения графиков временных рядов в Tableau.

SELECT * FROM (
    SELECT location, population, date,
           MAX(total_cases) as highest_infection_count, 
           MAX((total_cases::NUMERIC / population)) * 100 as percent_population_infected
    FROM "CovidDeaths"
    GROUP BY location, population, date
) t
ORDER BY percent_population_infected DESC;



-- 5. ПРОГРЕСС ВАКЦИНАЦИИ
-- Объединяем таблицы для сравнения численности населения с показателями вакцинации.
-- Используем оконную функцию для расчета скользящего общего кол-ва вакцинированных.

SELECT dea.continent, dea.location, dea.date, dea.population, vac.new_vaccinations
, SUM(vac.new_vaccinations::NUMERIC) OVER (Partition by dea.location ORDER BY dea.date) as rolling_people_vaccinated
-- , (rolling_people_vaccinated / population) * 100
FROM "CovidDeaths" dea
JOIN "CovidVaccination" vac 
     ON dea.location = vac."location" 
     AND dea.date = vac.date
WHERE dea.continent IS NOT NULL
ORDER BY dea.location, dea.date;


-- Используем CTE для расчета процента вакцинированного населения,
-- потому что не можем ссылаться на псевдоним rolling_people_vaccinated в том же операторе SELECT.

WITH pop_vs_vac AS (
SELECT dea.continent, dea.location, dea.date, dea.population, vac.new_vaccinations
, SUM(vac.new_vaccinations::NUMERIC) OVER (Partition by dea.location ORDER BY dea.date) as rolling_people_vaccinated
-- , (rolling_people_vaccinated / population) * 100
FROM "CovidDeaths" dea
JOIN "CovidVaccination" vac 
     ON dea.location = vac."location" 
     AND dea.date = vac.date
WHERE dea.continent IS NOT NULL
-- ORDER BY dea.location, dea.date
)
SELECT *, (rolling_people_vaccinated / population) * 100 as rolling_people_vaccinated_percent
FROM pop_vs_vac;



-- 6. ВИТРИНА ДАННЫХ
-- Создаем витрину данных с готовыми расчетами для визуализации в Tableau.

DROP TABLE IF EXISTS "PercentPopulationVaccinated";

CREATE TABLE "PercentPopulationVaccinated"
(
continent VARCHAR(255),
location VARCHAR(255),
date TIMESTAMP,
population NUMERIC,
new_vaccinations NUMERIC,
rolling_people_vaccinated NUMERIC
);

INSERT INTO "PercentPopulationVaccinated"
SELECT dea.continent, dea.location, dea.date, dea.population, vac.new_vaccinations
, SUM(vac.new_vaccinations::NUMERIC) OVER (Partition by dea.location ORDER BY dea.date) as rolling_people_vaccinated
-- , (rolling_people_vaccinated / population) * 100
FROM "CovidDeaths" dea
JOIN "CovidVaccination" vac 
     ON dea.location = vac."location" 
     AND dea.date = vac.date
WHERE dea.continent IS NOT NULL;

SELECT *, (rolling_people_vaccinated / population) * 100 as percent_population_vaccinated
FROM "PercentPopulationVaccinated";


-- Создадим представление для прямого подключения к Tableau.

CREATE VIEW "PopulationVaccinationRate" AS
SELECT dea.continent, dea.location, dea.date, dea.population, vac.new_vaccinations
, SUM(vac.new_vaccinations::NUMERIC) OVER (Partition by dea.location ORDER BY dea.date) as rolling_people_vaccinated
-- , (rolling_people_vaccinated / population) * 100
FROM "CovidDeaths" dea
JOIN "CovidVaccination" vac 
     ON dea.location = vac."location" 
     AND dea.date = vac.date
WHERE dea.continent IS NOT NULL;
